{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/brewjson/brewjson/main/schemas/0.2/house.json",
  "title": "BrewJSON house profile",
  "description": "One brewhouse: its equipment sets, and later its process numbers. Draft-07 to match BeerJSON 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["brewjson"],
  "properties": {
    "brewjson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "house"],
      "properties": {
        "version": { "type": "string", "const": "0.2.0" },
        "house": { "$ref": "#/definitions/HouseType" }
      }
    }
  },
  "definitions": {
    "HouseType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default_equipment", "equipment_sets"],
      "properties": {
        "name": { "type": "string" },
        "default_equipment": { "type": "string", "description": "Id of the equipment set new batches use unless told otherwise." },
        "equipment_sets": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/EquipmentSetType" } },
        "notes": { "type": "string", "description": "Markdown." }
      }
    },
    "EquipmentSetType": {
      "description": "A BeerJSON equipment set with the id BeerJSON doesn't give it. A batch snapshots the equipment object and records the id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "equipment"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "equipment": { "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/master/json/equipment.json#/definitions/EquipmentType" }
      }
    }
  }
}
